{
  "manifest_version": 3,
  "name": "AI Chatbot",
  "description": "Chat with a backend API.",
  "version": "1.0",
  "permissions": ["activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": ["http://localhost:5000/*"]
}
